#include<iostream> 
using namespace std; 
void quickSort(int a[], int low, int high) 
{ 
 int i,j,pivot,temp; 
 if(low<high) 
 { 
  pivot=a[low]; 
  i=low; 
  j=high; 
  while(i<j) 
  { 
   while(a[i]<=pivot&& i<high) 
     i++; 
   while(a[j]>pivot) 
     j--; 
   if(i<j); 
   { 
    temp=a[i]; 
    a[i]=a[j]; 
    a[j]=temp; 
   } 
  } 
  temp=a[low]; 
  a[low]=a[i]; 
  a[i]=temp; 
   
  quickSort(a,low,j-1); 
  quickSort(a,j+1,high); 
 } 
} 
int main() 
{ 
int a[20],n; 
cout<<"Enetr number of elements:"; 
cin>>n; 
cout<<"Enter the Elements:"<<endl; 
for(int i=0;i<n;i++) 
{ 
cin>>a[i]; 
} 
quickSort(a,0,n-1); 
cout<<"\nSorted Array:"<<endl; 
for(int i=0;i<n;i++) 
{ 
cout<<a[i]<<" "; 
} 
return 0; 
} 
 
