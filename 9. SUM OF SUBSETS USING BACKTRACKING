#include<iostream> 
using namespace std; 
int n, target; 
int a[20], X[20]; 
void sumofSubsets(int index,int sum) 
{ 
 if(sum==target) 
 { 
  cout<<"{"; 
  for(int i=0;i<n;i++) 
  { 
   if(X[i]==1) 
    cout<<a[i]<<" "; 
  } 
  cout<<"}\n"; 
  return; 
 } 
 if(index ==n||sum> target) 
   return; 
 X[index]=1; 
 sumofSubsets(index+1,sum+a[index]); 
 X[index]=0; 
 sumofSubsets(index+1,sum); 
} 
int main() 
{ 
 cout<<"Enter number of elements:"; 
 cin>>n; 
cout<<"Enter the elements:\n"; 
for(int i=0; i<n; i++) 
cin>>a[i]; 
cout<<"enter target sum:"; 
cin>>target; 
cout<<"\n subsets with sum" << target <<":\n"; 
sumofSubsets(0,0); 
return 0; 
}
